<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>

<body class="container mt-5">
    <div class="card p-4">
        <h2>
            <%= product.name %>
        </h2>
        <p><strong>Giá:</strong>
            <%= product.price.toLocaleString() %> đ
        </p>
        <p><strong>Loại sản phẩm:</strong>
            <%= product.categoryId ? product.categoryId.name : 'Không có' %>
        </p>
        <p><strong>Tồn kho:</strong>
            <%= product.stock %>
        </p>
        <p><strong>Mô tả:</strong>
            <%= product.description || 'Chưa có mô tả' %>
        </p>
        <div>
            <a href="/products/edit/<%= product._id %>" class="btn btn-warning">Sửa</a>
            <a href="/products" class="btn btn-secondary">Quay lại</a>
        </div>
    </div>
</body>

</html>