<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= product.id ? 'Edit Product' : 'Add Product' %>
    </title>
</head>

<body>
    <h1>
        <%= product.id ? 'Edit Product' : 'Add New Product' %>
    </h1>

    <form action="<%= product.id
        ? '/api/products/edit/' + product.id
        : '/api/products' %>" method="POST">

        <label for="name">Name:</label><br>
        <input type="text" id="name" name="name" value="<%= product.name || '' %>" required>
        <br><br>

        <label for="description">Description:</label><br>
        <textarea id="description" name="description" rows="4" cols="40"><%= product.description || '' %></textarea>
        <br><br>

        <label for="image">Image URL:</label><br>
        <input type="text" id="image" name="image" value="<%= product.image || '' %>"
            placeholder="https://example.com/image.jpg">
        <br><br>

        <label for="price">Price:</label><br>
        <input type="number" id="price" name="price" value="<%= product.price || '' %>" min="0" step="0.01" required>
        <br><br>

        <button type="submit">
            <%= product.id ? 'Update Product' : 'Add Product' %>
        </button>
    </form>

    <br>
    <a href="/api/products">Back to Product List</a>
</body>

</html>